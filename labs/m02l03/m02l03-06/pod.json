{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "checkout",
    "namespace": "payments"
  },
  "spec": {
    "securityContext": {
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "app",
        "image": "registry.example.com/checkout:4.2.1",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      },
      {
        "name": "log-shipper",
        "image": "registry.example.com/shipper:1.9.0",
        "securityContext": {
          "runAsUser": 0,
          "capabilities": {
            "add": [
              "SYS_ADMIN"
            ]
          }
        }
      }
    ]
  }
}
